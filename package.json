{
  "name": "dsh-yizi-themes",
  "version": "0.5.7",
  "description": "YiziMarkdown theme pack for DeepSeek Harness — 19 style themes, Theme Studio custom themes, custom brand, WCAG contrast checks and config transfer.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.2-alpha.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node prepare.mjs",
    "build": "node prepare.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/self-check.mjs && node scripts/hot-reload-check.mjs",
    "verify": "node scripts/typecheck.mjs && node scripts/self-check.mjs && node scripts/hot-reload-check.mjs && node prepare.mjs",
    "pack:tgz": "node prepare.mjs && npm pack"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "theme",
    "themes",
    "appearance",
    "custom-brand",
    "yizimarkdown"
  ],
  "author": "laoduu",
  "license": "MIT",
  "homepage": "https://github.com/laoduu/DeepSeek-Harness-yizi-themes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoduu/DeepSeek-Harness-yizi-themes.git"
  },
  "bugs": {
    "url": "https://github.com/laoduu/DeepSeek-Harness-yizi-themes/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3"
  }
}
